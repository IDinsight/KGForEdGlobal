{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skillOverrides": {
    "architect": "user-invocable-only",
    "auditor": "user-invocable-only",
    "developer": "user-invocable-only",
    "documenter": "user-invocable-only",
    "navigator": "user-invocable-only",
    "reviewer": "user-invocable-only",
    "scoper": "user-invocable-only",
    "synchronizer": "user-invocable-only",
    "tester": "user-invocable-only"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.standards/bin/hook.mjs\" stop",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
