# Template for the local .env file.
# Rename this file to .env.local and fill in the required values.

# DOCKER #
DOCKER_CADDY_IMAGE=caddy:2.10.2
DOCKER_PG_VECTOR_IMAGE=pgvector/pgvector:pg18
DOCKER_REDIS_IMAGE=redis:8.2.2-alpine

# FASTAPI #
# Notes
#
# 1. Generate a FASTAPI_API_KEY via: `import secrets; print(secrets.token_hex(32))`
# 2. Generate a FASTAPI_DOCS_PASSWORD via: `import secrets; secrets.token_urlsafe(32)`
FASTAPI_API_KEY=
FASTAPI_DOCS_PASSWORD=
FASTAPI_DOCS_USER=
FASTAPI_ENV=local
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# LITELLM #
LITELLM_MODEL_CHAT=gpt-4o
LITELLM_MODEL_DEFAULT=gpt-4o

# POSTGRES #
POSTGRES_ASYNC_API=asyncpg
POSTGRES_DB=skg-local
POSTGRES_DB_POOL_SIZE=10
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_SYNC_API=psycopg2
POSTGRES_USER=postgres

# REDIS #
REDIS_CACHE_PREFIX_CHAT=chat_sessions
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
