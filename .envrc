export PROJECT_ENV=local # Valid values: local | development | production

# Map PROJECT_ENV to file.
case "$PROJECT_ENV" in
  local)       ENV_FILE=".env.local" ;;
  development) ENV_FILE=".env.development" ;;
  production)  ENV_FILE=".env.production" ;;
  *)
    echo "✖ Invalid PROJECT_ENV='$PROJECT_ENV'. Use: local | development | production." >&2
    exit 1
    ;;
esac

# [OPTIONAL] Load global .env first if it exists so that environment-specific values
# can override it.
dotenv_if_exists .env

# Load the selected file.
if [[ -f "$ENV_FILE" ]]; then
  dotenv "$ENV_FILE"
  echo "✔ Loaded $ENV_FILE (PROJECT_ENV='$PROJECT_ENV')"
else
  echo "✖ Required env file '$ENV_FILE' not found." >&2
  exit 1
fi
