# Template for the global .env file.
# Rename this file to .env and fill in the required values.

# ANTHROPIC #
ANTHROPIC_API_KEY=

# LLM #
LLM_ANTHROPIC_EFFORT=high
LLM_ANTHROPIC_THINKING_BUDGET_TOKENS=16384
LLM_KG_MODEL=anthropic:claude-opus-4-7
LLM_OPENAI_REASONING_EFFORT=high
LLM_OPENAI_TEMPERATURE=0.0
LLM_OPENAI_TOP_P=0.95
LLM_PAGE_IR_EXTRACTION_MODEL=anthropic:claude-opus-4-7
LLM_PAGE_IR_VERIFICATION_MODEL=anthropic:claude-opus-4-7

# OPENAI #
OPENAI_API_KEY=

# PATHS #
# 1. Do NOT include trailing slashes in the paths.
PATHS_PROJECT_DIR=~/SenegalKG
