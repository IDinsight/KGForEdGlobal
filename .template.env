# Template for the global .env file.
# Rename this file to .env and fill in the required values.

# ANTHROPIC #
ANTHROPIC_API_KEY=

# LEARNING COMMONS #
LEARNING_COMMONS_EXPORT_SCHEMA_VERSION=2026-07-09

# LLM #
LLM_ANTHROPIC_EFFORT=high
LLM_ANTHROPIC_THINKING_BUDGET_TOKENS=16384
LLM_KG_MODEL=anthropic:claude-opus-5
LLM_LC_EVAL_JUDGE_MODEL=anthropic:claude-opus-5
LLM_MAX_OUTPUT_TOKENS=18432
LLM_OPENAI_REASONING_EFFORT=high
LLM_OPENAI_TEMPERATURE=0.0
LLM_OPENAI_TOP_P=0.95
LLM_PAGE_IR_EXTRACTION_MODEL=anthropic:claude-opus-5
LLM_PAGE_IR_VERIFICATION_MODEL=anthropic:claude-opus-5

# OPENAI #
OPENAI_API_KEY=

# PATHS #
# 1. Do NOT include trailing slashes in the paths.
PATHS_PROJECT_DIR=~/SenegalKG
