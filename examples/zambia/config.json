						},
						{
							"role": "subject",
							"title_template": "\\2"
						}
					],
					"match": "^GRADE\\s+(\\d+)\\s*:\\s*(.+)$"
				}
			],
			"table_local_only_roles": [
				"topic",
				"subtopic"
			],
			"violation_policy": "flag_unresolved"
		},
