# Template for the local .env file used by the backend.
# Rename this file to .env.local and fill in the required values.

# CHAT
# Notes
#
# 1. Set to "testing" to display chat history logging.
CHAT_ENV=testing

# LOGFIRE #
LOGFIRE_ENVIRONMENT=local
LOGFIRE_READ_TOKEN=
LOGFIRE_SEND_TO_LOGFIRE=false
LOGFIRE_TOKEN=

# LOGGING #
LOGGING_LOG_LEVEL=INFO

# PROMETHEUS #
PROMETHEUS_MULTIPROC_DIR=/tmp

# SENTRY #
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# TEXT GENERATION PARAMETERS #
TEXT_GENERATION_DEFAULT='{"frequency_penalty": 0.0, "n": 1, "presence_penalty": 0.0, "temperature": 0.0, "top_p": 0.9}'
TEXT_GENERATION_OPENAI='{"frequency_penalty": 0.0, "n": 1, "presence_penalty": 0.0, "temperature": 0.0, "top_p": 0.9}'
